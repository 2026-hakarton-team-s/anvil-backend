PORT=8080
CORS_ORIGIN=http://localhost:5173

# 비우면 패턴 풀로 규칙 후보를 만듭니다
# OpenAI 호환 API 키면 공급자를 바꿔 쓸 수 있습니다 (변수 이름은 OPENAI_ 그대로)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 기본은 OpenAI. Gemini 무료 키를 쓰려면 아래 두 줄로 바꾸세요
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_MODEL=gemini-2.5-flash-lite
OPENAI_BASE_URL=https://api.openai.com/v1

# WAF 연동 (docker compose up 후). 비우면 로컬 룰 검사만 동작
WAF_URL=
WAF_TEST_CMD=
WAF_RELOAD_CMD=
